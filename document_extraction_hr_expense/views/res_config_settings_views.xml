<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_hr_expense_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.expense.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="document_extraction_base.res_config_settings_view_form_document_extraction"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='ai_matching_rules_block']" position="inside">
                <setting id="default_expense_product_setting" 
                         string="Default Expense Product" 
                         help="Produk beban standar yang otomatis digunakan jika pengguna tidak memilih produk pada modal ekstraksi struk pengeluaran (hr.expense).">
                    <field name="default_expense_product_id" options="{'no_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
