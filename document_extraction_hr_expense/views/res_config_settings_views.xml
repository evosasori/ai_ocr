<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_hr_expense_ai" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.hr.expense.ai</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="document_extraction_base.res_config_settings_view_form_document_extraction"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='ai_matching_rules_container']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="default_expense_product_setting">
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Default Expense Product</span>
                        <div class="text-muted">Standard expense product automatically used if the user does not select a product in the expense receipt extraction modal.</div>
                        <div class="content-group mt-2">
                            <field name="ai_expense_product_id" options="{'no_create': True}"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
