<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_ai_preview_wizard_form" model="ir.ui.view">
        <field name="name">hr.expense.ai.preview.wizard.form</field>
        <field name="model">hr.expense.ai.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Expense Receipt Extraction Preview">
                <field name="expense_id" invisible="1"/>

                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class="fa fa-receipt fa-2x me-3 text-info"/>
                    <div>
                        <strong class="d-block mb-1">AI Receipt Extraction Analysis Results:</strong>
                        <span>Review and adjust the details below before applying them to the Expense record.</span>
                    </div>
                </div>

                <group>
                    <group string="Transaction Information">
                        <field name="merchant_name" placeholder="Store / Restaurant / Vendor Name"/>
                        <field name="date"/>
                        <field name="description" placeholder="Expense description..."/>
                        <field name="partner_id" options="{'no_create': True}" placeholder="Select contact if applicable..."/>
                    </group>
                    <group string="Amount &amp; Payment">
                        <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="total_amount" class="oe_inline fw-bold text-primary fs-5"/>
                        <field name="tax_amount"/>
                        <field name="category_suggestion" widget="badge"/>
                    </group>
                </group>

                <!-- Optional Product Selection Section -->
                <group string="Expense Category / Product">
                    <field name="product_id" 
                           options="{'no_create': True}"
                           placeholder="Select expense product or leave blank to use Default Settings..."/>
                </group>
                <div class="alert alert-light border py-2 px-3 small text-muted">
                    <i class="fa fa-info-circle me-1 text-primary"/>
                    <span><b>Note:</b> Product selection above is <i>optional</i>. If left empty, the system automatically applies the <b>Default Expense Product</b> configured in Settings.</span>
                </div>

                <notebook invisible="not raw_json_text">
                    <page string="Raw AI JSON">
                        <field name="raw_json_text" readonly="1" widget="text"/>
                    </page>
                </notebook>

                <footer>
                    <button name="action_apply_to_expense" 
                            string="✅ Confirm &amp; Apply to Expense" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
