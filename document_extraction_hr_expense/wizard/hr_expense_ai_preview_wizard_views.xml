<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_expense_ai_preview_wizard_form" model="ir.ui.view">
        <field name="name">hr.expense.ai.preview.wizard.form</field>
        <field name="model">hr.expense.ai.preview.wizard</field>
        <field name="arch" type="xml">
            <form string="Preview Ekstraksi Struk Pengeluaran AI">
                <field name="expense_id" invisible="1"/>

                <div class="alert alert-info d-flex align-items-center mb-3">
                    <i class="fa fa-receipt fa-2x me-3 text-info"/>
                    <div>
                        <strong class="d-block mb-1">Hasil Analisa Struk / Bukti Pengeluaran AI:</strong>
                        <span>Periksa dan sesuaikan rincian di bawah ini sebelum diterapkan ke record Expense.</span>
                    </div>
                </div>

                <group>
                    <group string="Informasi Transaksi">
                        <field name="merchant_name" placeholder="Nama Toko / Restoran / Vendor"/>
                        <field name="date"/>
                        <field name="description" placeholder="Keterangan pengeluaran..."/>
                        <field name="partner_id" options="{'no_create': True}" placeholder="Pilih kontak jika ada..."/>
                    </group>
                    <group string="Nominal &amp; Pembayaran">
                        <field name="currency_id" options="{'no_create': True, 'no_open': True}"/>
                        <field name="total_amount" class="oe_inline fw-bold text-primary fs-5"/>
                        <field name="tax_amount"/>
                        <field name="category_suggestion" widget="badge"/>
                    </group>
                </group>

                <!-- Optional Product Selection Section -->
                <group string="Kategori / Produk Beban">
                    <field name="product_id" 
                           options="{'no_create': True}"
                           placeholder="Pilih produk beban atau biarkan kosong untuk menggunakan Default Settings..."/>
                </group>
                <div class="alert alert-light border py-2 px-3 small text-muted">
                    <i class="fa fa-info-circle me-1 text-primary"/>
                    <span><b>Catatan:</b> Pilihan produk di atas bersifat <i>opsional</i>. Jika dikosongkan, sistem secara otomatis akan menggunakan <b>Default Expense Product</b> yang telah diatur di Settings.</span>
                </div>

                <notebook invisible="not raw_json_text">
                    <page string="Raw AI JSON">
                        <field name="raw_json_text" readonly="1" widget="text"/>
                    </page>
                </notebook>

                <footer>
                    <button name="action_apply_to_expense" 
                            string="✅ Konfirmasi &amp; Terapkan ke Expense" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Batal" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
