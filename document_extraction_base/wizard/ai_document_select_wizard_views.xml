<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ai_document_select_wizard_form" model="ir.ui.view">
        <field name="name">ai.document.select.wizard.form</field>
        <field name="model">ai.document.select.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Documents for AI Extraction">
                <field name="res_model" invisible="1"/>
                <field name="res_id" invisible="1"/>
                <field name="available_attachment_ids" invisible="1"/>

                <div class="alert alert-primary d-flex align-items-center mb-3">
                    <i class="fa fa-files-o fa-2x me-3 text-primary"/>
                    <div>
                        <strong class="d-block mb-1">Multiple Document Attachments Detected:</strong>
                        <span>Choose whether to extract a single document or merge multiple files (such as separate pages or continuation sheets) into a single transaction.</span>
                    </div>
                </div>

                <group>
                    <field name="mode" widget="radio"/>
                </group>

                <!-- Single Mode -->
                <group invisible="mode != 'single'" string="Select Primary Document">
                    <field name="selected_attachment_id" 
                           options="{'no_create': True, 'no_open': True}" 
                           domain="[('id', 'in', available_attachment_ids)]"
                           required="mode == 'single'"/>
                </group>

                <div class="alert alert-secondary py-2 px-3 small" invisible="mode != 'single'">
                    <i class="fa fa-check-circle me-1 text-success"/>
                    <span>Single Document Mode uses <b>1 quota credit</b>.</span>
                </div>

                <!-- Merge Mode -->
                <group invisible="mode != 'merge'" string="Select Documents to Merge">
                    <field name="selected_attachment_ids" 
                           widget="many2many_checkboxes" 
                           domain="[('id', 'in', available_attachment_ids)]"
                           required="mode == 'merge'"/>
                </group>

                <!-- Quota Alert Banner when Merging -->
                <div class="alert alert-warning py-3 px-3 mt-3 d-flex align-items-start" invisible="mode != 'merge'">
                    <i class="fa fa-exclamation-triangle fa-2x me-3 text-warning"/>
                    <div>
                        <strong class="d-block mb-1">⚠️ MULTI-DOCUMENT QUOTA NOTICE:</strong>
                        <span>
                            Merging documents consumes quota credits proportional to the number of selected files.
                            You selected <b><field name="quota_cost" class="oe_inline"/> documents</b>, which will consume 
                            <b><field name="quota_cost" class="oe_inline"/> quota credits</b> from your instance balance upon extraction.
                        </span>
                    </div>
                </div>

                <footer>
                    <button name="action_confirm_extract" 
                            string="⚡ Proceed with AI Extraction" 
                            type="object" 
                            class="btn-primary"/>
                    <button string="Cancel" 
                            class="btn-secondary" 
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
